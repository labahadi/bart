# Copy to .env.local and fill in from Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: turns on the AI fairness check (console.anthropic.com -> API keys). Server-only, never shared.
ANTHROPIC_API_KEY=

# Required for photos (server-only, never share or commit): Supabase -> Project Settings -> API Keys -> service_role / Secret key
SUPABASE_SERVICE_ROLE_KEY=
