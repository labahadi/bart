# Copy to .env.local and fill in from Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: turns on the AI fairness check (console.anthropic.com -> API keys). Server-only, never shared.
ANTHROPIC_API_KEY=

# Required for photos (server-only, never share or commit): Supabase -> Project Settings -> API Keys -> service_role / Secret key
SUPABASE_SERVICE_ROLE_KEY=

# Required for "Somewhere else on campus" meetups (server-only): Google Cloud -> Places API (New) + Routes API key
GOOGLE_MAPS_API_KEY=

# Optional: lets people link Google Calendar to see when both people are free (server-only).
# Google Cloud -> APIs & Services -> Credentials -> OAuth client ID (Web application)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Optional: phone push notifications. Make keys with:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@upenn.edu
# Any long random string; the same one goes in the Supabase webhook header x-push-secret
PUSH_WEBHOOK_SECRET=
